rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 合言葉から作った場所だけ読み書きできる。部屋の一覧は誰も取れない。
    match /rooms/{room}/status/{uid} {
      allow read: if request.auth != null;
      // 書き込めるのは自分の安否だけ
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'state', 'note', 'battery', 'shelter', 'at'])
        && request.resource.data.state in ['ok', 'hurt', 'help']
        && request.resource.data.note is string && request.resource.data.note.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.shelter is string && request.resource.data.shelter.size() <= 80
        && request.resource.data.at is number;
    }
  }
}
